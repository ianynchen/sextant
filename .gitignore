# Sextant workspaces — analysis output, regenerable, never committed.
# Unanchored: module workspaces live at module roots, including nested ones.
.sextant/

# The Tradewind adapter's api-key session mirror (2N design §1) — an audit
# log beside the module it explains, never a build input. Same unanchored
# treatment as `.sextant/`.
.tradewind/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/

# The shaded extractor, built by Gradle into the Python package it ships in.
src/sextant/extractor-jvm/

# ---- JVM: the extractor build, and fixture-repo builds in CI ----
build/
target/
.gradle/
.kotlin/
*.class

# ---- OS / editor (courtesy for collaborators without a global ignore) ----
.DS_Store
.idea/
.vscode/
*.iml

# Example projects cloned for testing — not ours, never committed
examples/

# The pinned typeshed copy (spec 2026-11-06 §3e) ships whole: its `stdlib/venv` and a stub
# package's `examples` folder are type files, not an environment or a clone. Only those two
# folders are named, so `__pycache__` and `.DS_Store` stay ignored there as everywhere.
!/src/sextant/resources/typeshed/stdlib/venv/
!/src/sextant/resources/typeshed/stubs/**/examples/
