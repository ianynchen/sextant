  "module": "spring-petclinic-api-gateway",
  "endpoints": {
    "inbound": {
      "http": 8
    },
    "outbound": {
      "http": 6
    }
  },
  "routes": {
    "inbound": [
      "(unresolved) /api/customer/**",
      "(unresolved) /api/genai/**",
