    "outbound": [
      "(unresolved) lb://customers-service",
      "(unresolved) lb://genai-service",
      "(unresolved) lb://vets-service",
      "(unresolved) lb://visits-service",
      "GET (unresolved)",
      "GET /owners/{ownerId}"
    ]
  }
}
