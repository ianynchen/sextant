<project xmlns="http://maven.apache.org/POM/4.0.0">
  <!--
    W63's live-run half. `jakarta-jws.yml`'s own scenario needs the FULL CXF
    runtime classpath (jaxb, woodstox, xmlschema, ws-addr...), not just the two
    coordinates the task brief names for `javap` — those are resolved
    `-Dtransitive=false` in `run.sh`; this file exists only so
    `dependency:build-classpath` can hand `sweep.py` a classpath that actually
    boots `JaxWsServiceFactoryBean`. It builds and runs nothing on its own.
  -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.sextant.probes</groupId>
  <artifactId>w63-cxf-fixture</artifactId>
  <version>1</version>
  <dependencies>
    <dependency>
      <groupId>org.apache.cxf</groupId>
      <artifactId>cxf-rt-frontend-jaxws</artifactId>
      <version>4.0.5</version>
    </dependency>
    <dependency>
      <groupId>jakarta.jws</groupId>
      <artifactId>jakarta.jws-api</artifactId>
      <version>3.0.0</version>
    </dependency>
  </dependencies>
</project>
