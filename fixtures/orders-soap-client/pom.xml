<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <!-- groupId and version are inherited, never restated: a reactor child that
       declares neither is ordinary Maven, and it is what makes this fixture's
       coordinate `com.example:orders-soap-client` a thing the build says rather
       than a thing this file repeats. -->
  <parent>
    <groupId>com.example</groupId>
    <artifactId>fixtures</artifactId>
    <version>1.0.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>orders-soap-client</artifactId>
  <!-- The whole library: one `wsimport`-shaped service endpoint interface and
       the annotations it is declared with. It ships NO implementation, which is
       the point — `jakarta-jws-client.yml`'s SEI fence subtracts every
       interface the analysed module implements, so a stub that were implemented
       locally would derive nothing at all. -->
  <dependencies>
    <!-- For `ConflictingOrderException`'s `@ResponseStatus` — a THIRD-PARTY exception class
         carrying the framework's status annotation, which is the shape COVERAGE row
         "@ResponseStatus on the EXCEPTION CLASS" said derives nothing when the class lives in
         a jar this workspace never scanned. `orders-advice` depends on this stub WITHOUT
         opting in through `extract_libraries`, so only a header read of the classpath can
         see this annotation. `provided`, because a stub library's consumers bring their own
         Spring. -->
    <dependency>
      <groupId>org.springframework</groupId><artifactId>spring-web</artifactId>
      <version>6.1.6</version><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.jws</groupId>
      <artifactId>jakarta.jws-api</artifactId>
      <version>3.0.0</version>
    </dependency>
  </dependencies>
</project>
