<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.acme</groupId>
  <artifactId>orders-ktor</artifactId>
  <version>1.0.0</version>
  <!-- Ktor (`ktor-routing`), in its own module: a Kotlin server stack with no Spring, so
       `orders-service`'s pinned row counts do not move. Compiled, never run. The API jar
       is declared alone, but NOT with `orders-javalin`'s `<exclusions>*`: the Kotlin
       compiler resolves the supertypes of every type a source names (`Routing` extends
       `Route`, which lives here, but `Application` sits on `ktor-utils`' `Attributes`
       and `ktor-http`'s types), so the transitive jars must be on the compile classpath
       — the first `mvn compile` fetches them ONLINE and every later one runs `-o`.
       Ktor 3.6.0, the version the real corpora build against (spec 2026-10-26 §3f), with
       the WebSocket and SSE server plugins and the HTTP client and its CIO engine for
       `KtorStreams.kt` and `KtorClient.kt`. Kotlin 2.4.20, the compiler the real corpora use,
       now that the extractor reads its metadata (OI-219). The class-lambda twin
       `orders-ktor-classlambdas` stays on Ktor 3.0.3 and Kotlin 2.2.0, so the older
       compiler's and library's shapes stay pinned on real bytecode too.
       Built with JDK 21 (javac 27 renumbers lambdas). -->
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <kotlin.version>2.4.20</kotlin.version>
    <ktor.version>3.6.0</ktor.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-stdlib</artifactId><version>${kotlin.version}</version></dependency>
    <dependency><groupId>org.jetbrains.kotlinx</groupId><artifactId>kotlinx-coroutines-core-jvm</artifactId><version>1.11.0</version></dependency>
    <dependency><groupId>io.ktor</groupId><artifactId>ktor-server-core-jvm</artifactId><version>${ktor.version}</version></dependency>
    <dependency><groupId>io.ktor</groupId><artifactId>ktor-server-websockets-jvm</artifactId><version>${ktor.version}</version></dependency>
    <dependency><groupId>io.ktor</groupId><artifactId>ktor-server-sse-jvm</artifactId><version>${ktor.version}</version></dependency>
    <dependency><groupId>io.ktor</groupId><artifactId>ktor-client-core-jvm</artifactId><version>${ktor.version}</version></dependency>
    <dependency><groupId>io.ktor</groupId><artifactId>ktor-client-cio-jvm</artifactId><version>${ktor.version}</version></dependency>
  </dependencies>
  <build>
    <sourceDirectory>src/main/kotlin</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-maven-plugin</artifactId><version>${kotlin.version}</version>
        <executions><execution><id>compile</id><phase>compile</phase><goals><goal>compile</goal></goals></execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
