<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example</groupId>
  <artifactId>spring-integration-probe</artifactId>
  <version>1.0.0</version>
  <!-- The committed harness (R7) for
       `scripts/probes/spring-integration-destinations.md`: a standalone
       fixture, independent of `orders-service` and of `grpc-probe`, whose sole
       purpose is a compiled Spring Integration surface — a DSL flow, an
       adapter bean joined to an annotated handler by a named channel, a
       polled inbound adapter, Kafka/JMS adapters alongside AMQP, and a
       deliberate spread of destination-expression shapes — for the probe to
       run the extractor against and re-run later.

       Versions are pinned through the Spring Boot 3.2.5 BOM, the same Boot
       line `fixtures/orders-service` builds against; §5.4 bounds this probe's
       evidence to exactly these: Spring Integration 6.2.4, spring-amqp 3.1.4,
       spring-kafka 3.1.4, Spring Framework 6.1.6. -->
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>3.2.5</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-integration</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.integration</groupId>
      <artifactId>spring-integration-amqp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.integration</groupId>
      <artifactId>spring-integration-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.integration</groupId>
      <artifactId>spring-integration-jms</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.amqp</groupId>
      <artifactId>spring-rabbit</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jms</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.jms</groupId>
      <artifactId>jakarta.jms-api</artifactId>
    </dependency>
    <!-- Spring Integration adapters and flows (spec 2026-09-21 §11): the Pub/Sub
         channel adapter and message handler `Shape4PubSub` builds. Not managed by
         the Boot BOM, so pinned here — the same version `fixtures/orders-service`
         builds against, and the one CP-28 measures. -->
    <dependency>
      <groupId>com.google.cloud</groupId>
      <artifactId>spring-cloud-gcp-pubsub</artifactId>
      <version>5.1.2</version>
    </dependency>
  </dependencies>
</project>
