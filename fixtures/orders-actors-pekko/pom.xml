<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.acme</groupId>
  <artifactId>orders-actors-pekko</artifactId>
  <version>1.0.0</version>
  <!-- Pekko typed actors, cluster sharding, receptionist, persistence and classic
       pub-sub. API jars only; never runs. In its own module so that no other
       fixture's pinned row counts move. -->
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency><groupId>org.apache.pekko</groupId><artifactId>pekko-actor_2.13</artifactId><version>1.1.3</version></dependency>
    <dependency><groupId>org.apache.pekko</groupId><artifactId>pekko-actor-typed_2.13</artifactId><version>1.1.3</version></dependency>
    <dependency><groupId>org.apache.pekko</groupId><artifactId>pekko-cluster-typed_2.13</artifactId><version>1.1.3</version></dependency>
    <dependency><groupId>org.apache.pekko</groupId><artifactId>pekko-cluster-sharding-typed_2.13</artifactId><version>1.1.3</version></dependency>
    <dependency><groupId>org.apache.pekko</groupId><artifactId>pekko-cluster-tools_2.13</artifactId><version>1.1.3</version></dependency>
    <dependency><groupId>org.apache.pekko</groupId><artifactId>pekko-persistence-typed_2.13</artifactId><version>1.1.3</version></dependency>
  </dependencies>
</project>
