<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.acme</groupId>
  <artifactId>orders-micronaut</artifactId>
  <version>1.0.0</version>
  <!-- Micronaut, in its own module: a second JVM web framework the way a second
       application would use it, not Spring with different imports. Only the annotation
       artifacts — the fixture compiles against the API and never runs. -->
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.micronaut</groupId>
      <artifactId>micronaut-http</artifactId>
      <version>4.7.6</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>io.micronaut</groupId>
      <artifactId>micronaut-http-client-core</artifactId>
      <version>4.7.6</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>io.micronaut</groupId>
      <artifactId>micronaut-inject</artifactId>
      <version>4.7.6</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <!-- The three messaging integrations, annotation artifacts only. -->
    <dependency>
      <groupId>io.micronaut.kafka</groupId><artifactId>micronaut-kafka</artifactId><version>5.6.0</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>io.micronaut.jms</groupId><artifactId>micronaut-jms-core</artifactId><version>4.2.0</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>io.micronaut.gcp</groupId><artifactId>micronaut-gcp-pubsub</artifactId><version>5.8.0</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <!-- `@jakarta.inject.Singleton` on `SqsPoller`: `micronaut-inject`'s own transitive
         copy is excluded above like everything else in this file, so it has to be
         declared directly. Version matches what `micronaut-inject:4.7.6`'s own POM
         names. -->
    <dependency>
      <groupId>jakarta.inject</groupId><artifactId>jakarta.inject-api</artifactId><version>2.0.1</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <!-- The raw AWS SDK client, the same coordinate `aws-sqs-sdk.yml` detects on
         `orders-service` — a Micronaut module reaching SQS with no first-party
         annotation at all (`micronaut-jms-sqs` is a JMS `ConnectionFactory`, not an SQS
         annotation; see `OrderMessaging`'s `@JMSListener`/`@JMSProducer` pair, which reads
         as protocol `jms`, not `sqs`). `utils`/`sdk-core`/`aws-core` are declared
         alongside it, each with the whole-tree exclusion this file always uses, because
         `SqsClient`'s and `SendMessageRequest`'s own supertypes live in those three jars
         and `sqs`'s transitives are excluded like everything else here. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId><artifactId>sqs</artifactId><version>2.25.31</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId><artifactId>utils</artifactId><version>2.25.31</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId><artifactId>sdk-core</artifactId><version>2.25.31</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId><artifactId>aws-core</artifactId><version>2.25.31</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
  </dependencies>
</project>
