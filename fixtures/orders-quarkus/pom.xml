<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.acme</groupId>
  <artifactId>orders-quarkus</artifactId>
  <version>1.0.0</version>
  <!-- Quarkus reactive routes, in its own module: a Quarkus application declares HTTP
       handlers with `@Route` on any bean rather than with JAX-RS. Only the annotation
       artifact — the fixture compiles against the API and never runs. -->
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <!-- Groups B and C (spec §3e/§3f): the Quarkus REST (JAX-RS) surface and the
       MicroProfile REST Client, beside the reactive routes this module already had.
       The BOM pins every version below; nothing here declares its own. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>3.17.5</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-reactive-routes</artifactId>
      <version>3.17.5</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <!-- `OrderResource`'s five Quarkus REST cases (§3e) — the API only, same
         all-exclusions pattern `quarkus-reactive-routes` above uses. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>jakarta.ws.rs</groupId>
      <artifactId>jakarta.ws.rs-api</artifactId>
    </dependency>
    <!-- `@RestStreamElementType`, `@RestForm`, `@RestPath`. The BOM publishes this
         artifact under `io.quarkus.resteasy.reactive`, not the upstream
         `org.jboss.resteasy.reactive` groupId — same package name (`org.jboss.
         resteasy.reactive`) on the classes, Quarkus's own fork's coordinate. -->
    <dependency>
      <groupId>io.quarkus.resteasy.reactive</groupId>
      <artifactId>resteasy-reactive-common</artifactId>
    </dependency>
    <!-- `Multi`, the return type of `OrderResource`'s SSE handlers. -->
    <dependency>
      <groupId>io.smallrye.reactive</groupId>
      <artifactId>mutiny</artifactId>
    </dependency>
    <!-- `RoutingContext`, injected without `@Context` on `whoami`. -->
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-web</artifactId>
    </dependency>
    <!-- `OrdersClient`/`BillingClient`'s `@RegisterRestClient` (spec §3f). -->
    <dependency>
      <groupId>org.eclipse.microprofile.rest.client</groupId>
      <artifactId>microprofile-rest-client-api</artifactId>
      <version>4.0</version>
    </dependency>
    <!-- Quarkus messaging (spec 2026-10-24 §3e): the Kafka extension is the module's ONE
         connector, which is what attaches every orphan channel to Kafka. The extension
         alone, all-exclusions; the annotations and `Emitter` come from the SmallRye API
         jar that shades the MicroProfile one (CP-49). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-messaging-kafka</artifactId>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>io.smallrye.reactive</groupId>
      <artifactId>smallrye-reactive-messaging-api</artifactId>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <!-- `QuoteRequester`'s `@Inject`. -->
    <dependency>
      <groupId>jakarta.inject</groupId>
      <artifactId>jakarta.inject-api</artifactId>
    </dependency>
  </dependencies>
</project>
