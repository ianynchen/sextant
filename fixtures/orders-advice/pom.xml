<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.example</groupId>
    <artifactId>fixtures</artifactId>
    <version>1.0.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>orders-advice</artifactId>
  <!-- The two `@ControllerAdvice` rows COVERAGE marked "narrower than the framework's rule",
       both for one cause: the handled exception lives in a jar this workspace never scanned.
       No `.sextant.yml` here on purpose — `orders-service` opts the stub in through
       `extract_libraries`, and this module must NOT, or the header read has nothing to add. -->
  <dependencies>
    <dependency>
      <groupId>org.springframework</groupId><artifactId>spring-web</artifactId><version>6.1.6</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId><artifactId>spring-boot</artifactId><version>3.5.10</version>
    </dependency>
    <!-- `spring-context` is NOT declared here, and that is the point of it.
         `MethodArgumentNotValidException` (spring-web) extends `BindException` (spring-context),
         and spring-context reaches this module only as `spring-boot`'s own transitive. Until
         2026-10-21 the header read walked the DIRECT declarations and this line had to be
         declared to prove the chain (OI-167); the classpath is now the one Maven resolved
         (`target/sextant-classpath.txt`, spec 2026-10-21-maven-classpath-design.md), so the
         chain crosses the transitive — which is the shape every Spring Boot starter has. -->
    <dependency>
      <groupId>com.example</groupId><artifactId>orders-soap-client</artifactId><version>1.0.0</version>
    </dependency>
  </dependencies>
</project>
