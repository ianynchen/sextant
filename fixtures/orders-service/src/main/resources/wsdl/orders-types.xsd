<?xml version="1.0" encoding="UTF-8"?>
<!-- Schema-first fixture for the SOAP surfaces (2I design). placeOrderRequest's
     QName (namespace + localPart) must agree with OrderSoapEndpoint's
     @PayloadRoot row — the annotation/schema agreement pin. quoteOrderRequest
     has no annotated Java counterpart anywhere in this fixture — the
     schema-first-only operation. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://orders.example.com/ws"
           targetNamespace="http://orders.example.com/ws"
           elementFormDefault="qualified">

  <!-- The enumeration-facet type pin. -->
  <xs:simpleType name="status">
    <xs:restriction base="xs:string">
      <xs:enumeration value="NEW"/>
      <xs:enumeration value="CONFIRMED"/>
      <xs:enumeration value="SHIPPED"/>
      <xs:enumeration value="CANCELLED"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="placeOrderRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sku" type="xs:string"/>
        <xs:element name="count" type="xs:int"/>
        <xs:element name="note" type="xs:string" minOccurs="0"/>
        <xs:element name="tags" type="xs:string" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="quoteOrderRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sku" type="xs:string"/>
        <xs:element name="count" type="xs:int"/>
        <xs:element name="status" type="tns:status"/>
        <!-- The nillable="true" element pin. -->
        <xs:element name="cancelledAt" type="xs:dateTime" nillable="true"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
