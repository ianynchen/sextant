<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.acme</groupId>
  <artifactId>reactor-twoservice</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <!-- A two-module REACTOR, one module calling an address the other serves — the smallest
       thing the stitcher can be measured on that does not need `examples/` cloned.

       The module directories are deliberately NOT the service names: `orders-api` registers
       as `orders` and `billing-api` as `billing`, which is `spring-petclinic`'s own shape
       (artifactId `spring-petclinic-customers-service`, registered name `customers-service`)
       and the reason a participant answers to both names. -->
  <modules>
    <module>orders-api</module>
    <module>billing-api</module>
  </modules>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
</project>
