<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.acme</groupId>
  <artifactId>orders-eventbus</artifactId>
  <version>1.0.0</version>
  <!-- The Vert.x event bus, raw and through Quarkus's `@ConsumeEvent`
       (CP-31, `docs/superpowers/specs/2026-09-22-temporal-and-eventbus-design.md`
       §4). API jars only, every dependency blanket-excluded so nothing
       transitive resolves — the `temporal-probe`/`orders-pekko` shape. This
       module never runs; it exists to be `javap`'d (CP-31's fixture row) and
       to be scanned by `vertx-eventbus.yml`, `vertx-eventbus-chain.yml` and
       `quarkus-consume-event.yml`.

       vertx-core is pinned to 4.5.10 EXPLICITLY rather than taken from a
       Quarkus BOM: CP-31 measures 4.5.10 and 5.0.0, the catalogs declare the
       overloads of both in one file, and a fixture whose version drifted with
       a BOM would silently stop exercising the rows its tests pin. 4.5 is the
       line quarkus-vertx 3.17.5 itself builds against, so the two arms of this
       fixture are a combination that really ships; the 5.0-only
       `consumer(MessageConsumerOptions)` overload is therefore NOT exercised
       here, which is the point of spec §3a's rule that an overload absent from
       the version a module builds against simply never matches. -->
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.vertx</groupId><artifactId>vertx-core</artifactId><version>4.5.10</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId><artifactId>quarkus-vertx</artifactId><version>3.17.5</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <!-- `MutinyOrderBus`'s arm (fix round 1): the facade a Quarkus service actually
         injects. Pinned to 3.16.0, the version CP-31 Q8 measured, and `mutiny` beside
         it for `Uni`, which is `request(...)`'s declared return type. -->
    <dependency>
      <groupId>io.smallrye.reactive</groupId><artifactId>smallrye-mutiny-vertx-core</artifactId><version>3.16.0</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>io.smallrye.reactive</groupId><artifactId>mutiny</artifactId><version>2.6.2</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
  </dependencies>
</project>
